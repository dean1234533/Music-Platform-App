rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function existingUserRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function hasRole(role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        role in existingUserRoles();
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // Whether uid's account currently holds `role` — the live source of
    // truth for public profile visibility, not just "does a profile doc
    // exist". Stepping back from the artist/dj role (removeRole) hides the
    // public profile immediately without touching or deleting the profile
    // doc itself, so re-adding the role (AddRolePage) restores it exactly
    // as it was.
    function roleActiveFor(uid, role) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && role in get(/databases/$(database)/documents/users/$(uid)).data.roles;
    }

    function hasActiveSupportFor(artistId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/supportRelationships/$(request.auth.uid + '_' + artistId))
        && exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid + '_fan'))
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid + '_fan')).data.status in ['active', 'trialing'];
    }

    // ---------------------------------------------------------------------
    // users/{userId} — private account document. Owner can read/update it,
    // but can never touch roles beyond fan/artist/dj, never grant themselves
    // admin, and never write subscriptionStatus, stripeCustomerId, or
    // suspended (all Cloud-Function/Admin-SDK only). Admins can read any
    // user for the admin dashboard, but writes to other accounts still only
    // happen through callables (adminSetUserSuspension etc.), never a raw
    // client write, so every admin action produces an audit log entry.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.roles.size() == 0
        && request.resource.data.onboardingComplete == false
        && request.resource.data.subscriptionStatus == 'none';

      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.get('stripeCustomerId', null) == resource.data.get('stripeCustomerId', null)
        && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
        && (
          // Normal account, first-ever role write (initial onboarding —
          // the doc was created with roles == [] and this is the one write
          // that sets it): may set any subset of fan/artist/dj, once. A
          // platform has to let a brand-new signup pick its own first role.
          (resource.data.roles.size() == 0 && request.resource.data.roles.hasOnly(['fan', 'artist', 'dj']))
          // Normal account, already onboarded: roles are completely frozen
          // on this client path from here on — no self-service add OR
          // remove, ever again. Adding a later role (e.g. a fan becoming an
          // artist) or stepping back from one is admin-only.
          || (resource.data.roles.hasOnly(['fan', 'artist', 'dj']) && request.resource.data.roles == resource.data.roles)
          // Admin account: free to add or remove its own fan/artist/dj
          // roles — including stepping back from all of them to operate
          // invisibly — but 'admin' itself can never be touched through
          // this client path; granting or revoking admin is backend-only.
          || (resource.data.roles.hasAny(['admin'])
              && request.resource.data.roles.hasAny(['admin'])
              && request.resource.data.roles.removeAll(['admin']).hasOnly(['fan', 'artist', 'dj']))
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // artistProfiles/{artistId} — public read. Only the owning artist can
    // write, and only to their own document (artistId == uid). verified/
    // followerCount/supporterCount are frozen — Cloud Functions only.
    // ---------------------------------------------------------------------
    match /artistProfiles/{artistId} {
      // Public only while the account still actually holds the artist role
      // — stepping back from it (removeRole) hides this from everyone but
      // the owner and admins, without deleting anything.
      allow read: if roleActiveFor(artistId, 'artist') || isSelf(artistId) || isAdmin();
      // Creation is Cloud-Function-only (createArtistProfile) — it also
      // grants the artist role in the same server-side transaction, which
      // a direct client create here never could (users/{userId}'s own
      // rules freeze a regular account's roles after signup). Admin SDK
      // writes bypass these rules entirely, so this doesn't block that path.
      allow create: if false;
      // trackCount is server-maintained. Perks are artist-writable.
      allow update: if isSelf(artistId)
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.followerCount == resource.data.followerCount
        && request.resource.data.supporterCount == resource.data.supporterCount
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.get('trackCount', 0) == resource.data.get('trackCount', 0)
        && request.resource.data.get('profileViews', 0) == resource.data.get('profileViews', 0)
        && request.resource.data.get('referralViews', {}) == resource.data.get('referralViews', {})
        && request.resource.data.get('followConversions', 0) == resource.data.get('followConversions', 0)
        && request.resource.data.get('supportConversions', 0) == resource.data.get('supportConversions', 0);
      allow delete: if false;
    }

    // artistSlugs/{slug} — reservation records; immutable once created.
    match /artistSlugs/{slug} {
      allow read: if true;
      // Reservation happens inside createArtistProfile's transaction (Admin
      // SDK, bypasses this rule) or adminChangeArtistSlug — never a direct
      // client write, so two artists can never race for the same slug
      // outside a server-controlled transaction.
      allow create: if false;
      allow update, delete: if false;
    }

    match /djProfiles/{djId} {
      // Same live-role gate as artistProfiles above.
      allow read: if roleActiveFor(djId, 'dj') || isSelf(djId) || isAdmin();
      // Creation is Cloud-Function-only (createDJProfile) — same reasoning as artistProfiles above.
      allow create: if false;
      // Verification is server-maintained. bulkOutreachOptIn is DJ-writable.
      allow update: if isSelf(djId)
        && request.resource.data.djId == resource.data.djId
        && request.resource.data.verificationStatus == resource.data.verificationStatus;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // tracks/{trackId} — visibility-gated read, owner-only write. Supporter/
    // follower-gated visibility is enforced client-side for now (Storage
    // rules are the real gate on the audio file itself); playCount and
    // takenDown are frozen from client writes.
    // ---------------------------------------------------------------------
    match /tracks/{trackId} {
      // Metadata (title/artwork/etc, never audio) is readable for any
      // non-private, non-dj_only-to-non-DJs track, even by a signed-out
      // visitor — the public profile shows a locked followers/supporters
      // track with a Follow/Support CTA rather than hiding it outright. The
      // real gate is entirely in getTrackPlaybackUrl + storage.rules: this
      // doc never contains playable audio, only Storage paths that are
      // owner-only at the Storage layer regardless of who can read this doc.
      // The artist-still-holds-the-role gate also applies here — the same
      // stepping-back that hides artistProfiles hides their tracks too, not
      // just the profile page, so a bookmarked/shared track link goes dark
      // along with everything else.
      allow read: if ((resource.data.get('status', 'published') == 'published')
        && roleActiveFor(resource.data.artistId, 'artist')
        && (
           resource.data.visibility == 'public'
        || resource.data.visibility == 'followers'
        || resource.data.visibility == 'supporters'
        || resource.data.visibility == 'early_access'
        || (resource.data.visibility == 'dj_only' && hasRole('dj'))))
        || (isSignedIn() && resource.data.artistId == request.auth.uid)
        || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.artistId == request.auth.uid
        && request.resource.data.originalAudioPath.matches('artists/' + request.auth.uid + '/originals/' + trackId + '.+')
        && request.resource.data.streamAudioPath.matches('artists/' + request.auth.uid + '/streaming/' + trackId + '.+')
        && request.resource.data.previewAudioPath.matches('artists/' + request.auth.uid + '/previews/' + trackId + '.+')
        && (request.resource.data.djPromotion == false || (
            request.resource.data.djPreviewAudioPath.matches('artists/' + request.auth.uid + '/dj-previews/' + trackId + '.+')
            && request.resource.data.djPreviewStartSec >= 0
            && request.resource.data.djPreviewDurationSec >= 5
            && request.resource.data.djPreviewStartSec + request.resource.data.djPreviewDurationSec <= request.resource.data.durationSeconds))
        && hasRole('artist')
        // Keep this finite storage allowance in sync with platformLimits.ts.
        && exists(/databases/$(database)/documents/artistProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/artistProfiles/$(request.auth.uid)).data.get('trackCount', 0) < 10
        // Publishing requires an active Artist Membership — dashboard access itself stays open.
        && exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid + '_artist'))
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid + '_artist')).data.status in ['active', 'trialing']
        && request.resource.data.rightsConfirmed == true
        && request.resource.data.durationSeconds is number
        && request.resource.data.durationSeconds > 0
        && request.resource.data.durationFormatted is string
        && request.resource.data.previewEnabled is bool
        && request.resource.data.previewStartSec is number
        && request.resource.data.previewStartSec >= 0
        && request.resource.data.previewDurationSec is number
        && request.resource.data.previewDurationSec >= 5
        && request.resource.data.previewDurationSec <= 90
        && (request.resource.data.previewEnabled == false
            || request.resource.data.previewStartSec + request.resource.data.previewDurationSec <= request.resource.data.durationSeconds)
        && request.resource.data.status == 'published'
        && request.resource.data.playCount == 0;

      allow update: if isSignedIn()
        && resource.data.artistId == request.auth.uid
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.originalAudioPath == resource.data.originalAudioPath
        && request.resource.data.streamAudioPath == resource.data.streamAudioPath
        && request.resource.data.previewAudioPath == resource.data.previewAudioPath
        && request.resource.data.get('djPreviewAudioPath', null) == resource.data.get('djPreviewAudioPath', null)
        && request.resource.data.playCount == resource.data.playCount
        && request.resource.data.get('fullPlayCount', 0) == resource.data.get('fullPlayCount', 0)
        && request.resource.data.get('supporterPlayCount', 0) == resource.data.get('supporterPlayCount', 0)
        && request.resource.data.get('djPreviewCount', 0) == resource.data.get('djPreviewCount', 0)
        && request.resource.data.get('djPreviewPlays', 0) == resource.data.get('djPreviewPlays', 0)
        && request.resource.data.get('previewStarts', 0) == resource.data.get('previewStarts', 0)
        && request.resource.data.get('previewCompletions', 0) == resource.data.get('previewCompletions', 0)
        && request.resource.data.get('fullTrackStarts', 0) == resource.data.get('fullTrackStarts', 0)
        && request.resource.data.get('fullTrackCompletions', 0) == resource.data.get('fullTrackCompletions', 0)
        && request.resource.data.get('followerFullPlays', 0) == resource.data.get('followerFullPlays', 0)
        && request.resource.data.get('publicFullPlays', 0) == resource.data.get('publicFullPlays', 0)
        && request.resource.data.get('supporterFullPlays', 0) == resource.data.get('supporterFullPlays', 0)
        && request.resource.data.get('status', 'published') == resource.data.get('status', 'published')
        && request.resource.data.get('durationSeconds', 0) == resource.data.get('durationSeconds', 0)
        && request.resource.data.get('durationFormatted', '') == resource.data.get('durationFormatted', '')
        && request.resource.data.get('previewEnabled', true) is bool
        && request.resource.data.previewStartSec >= 0
        && request.resource.data.previewDurationSec >= 5
        && request.resource.data.previewDurationSec <= 90
        && (request.resource.data.get('previewEnabled', true) == false
            || resource.data.get('durationSeconds', 0) == 0
            || request.resource.data.previewStartSec + request.resource.data.previewDurationSec <= resource.data.durationSeconds)
        && request.resource.data.get('takenDown', false) == resource.data.get('takenDown', false)
        && request.resource.data.get('fileHash', null) == resource.data.get('fileHash', null)
        && request.resource.data.get('fileSize', null) == resource.data.get('fileSize', null)
        && request.resource.data.get('mimeType', null) == resource.data.get('mimeType', null)
        && request.resource.data.get('hashCheckedAt', null) == resource.data.get('hashCheckedAt', null)
        && request.resource.data.get('possibleDuplicateOfTrackId', null) == resource.data.get('possibleDuplicateOfTrackId', null)
        && request.resource.data.get('restrictedCapabilities', []) == resource.data.get('restrictedCapabilities', [])
        && request.resource.data.get('legalHold', false) == resource.data.get('legalHold', false)
        && request.resource.data.get('trackSlug', null) == resource.data.get('trackSlug', null)
        && request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0);

      // Server callable performs licence/legal-hold checks and media cleanup.
      allow delete: if false;
    }

    match /trackSlugs/{registryId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.artistId == request.auth.uid;
      allow update, delete: if false;
    }

    match /albums/{albumId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.resource.data.artistId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.artistId == request.auth.uid;
    }

    // follows/{fanId_artistId} — only the fan can read/write their own follow.
    // followerCount on artistProfiles is updated server-side by a trigger.
    match /follows/{followId} {
      // resource == null short-circuits for the common "not following" case
      // — subscribeIsFollowing reads a doc that usually doesn't exist.
      allow read: if isSignedIn() && (resource == null || resource.data.fanId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fanId == request.auth.uid
        && followId == request.resource.data.fanId + '_' + request.resource.data.artistId;
      allow delete: if isSignedIn() && resource.data.fanId == request.auth.uid;
      allow update: if false;
    }

    // blockedUsers/{blockerId_blockedId} — who I've blocked. Read is
    // blocker-only (the blocked party never gets to see they're blocked
    // through this doc); enforcement (e.g. sendMessage refusing to deliver
    // between two users where either has blocked the other) happens
    // server-side via the Admin SDK, which isn't limited by this read rule.
    match /blockedUsers/{blockId} {
      allow read: if isSignedIn() && (resource == null || resource.data.blockerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.resource.data.blockerId + '_' + request.resource.data.blockedId;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /trackLikes/{likeId} {
      // resource == null short-circuits for the common "not liked" case —
      // subscribeIsLiked reads a doc that usually doesn't exist.
      allow read: if isSignedIn() && (resource == null || resource.data.fanId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fanId == request.auth.uid
        && likeId == request.resource.data.fanId + '_' + request.resource.data.trackId;
      allow delete: if isSignedIn() && resource.data.fanId == request.auth.uid;
      allow update: if false;
    }

    match /playlists/{playlistId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // crates/{crateId} — DJ-only equivalent of playlists (saved/organized
    // track lists for a set). Kept as a separate collection so fan playlist
    // queries and DJ crate queries never conflate.
    match /crates/{crateId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && hasRole('dj');
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /artistPosts/{postId} {
      allow read: if resource.data.visibility == 'everyone'
        || (isSignedIn() && resource.data.artistId == request.auth.uid)
        || (resource.data.visibility == 'followers' && isSignedIn() && (
            exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.artistId))
            || hasActiveSupportFor(resource.data.artistId)))
        || (resource.data.visibility == 'supporters' && hasActiveSupportFor(resource.data.artistId));
      allow create: if isSignedIn() && request.resource.data.artistId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.artistId == request.auth.uid;
    }

    // Artist-created benefits for listeners. Audience access mirrors posts;
    // redemption details are part of the offer and therefore protected by
    // the same visibility check.
    match /fanOffers/{offerId} {
      allow read: if resource.data.audience == 'everyone'
        || (isSignedIn() && resource.data.artistId == request.auth.uid)
        || (resource.data.audience == 'followers' && isSignedIn() &&
            exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.artistId)))
        || (resource.data.audience == 'supporters' && hasActiveSupportFor(resource.data.artistId));
      allow create: if isSignedIn()
        && hasRole('artist')
        && request.resource.data.artistId == request.auth.uid
        && request.resource.data.offerId == offerId;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.artistId == request.auth.uid;
    }

    match /fanOfferClaims/{claimId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.fanId == request.auth.uid || resource.data.artistId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fanId == request.auth.uid
        && request.resource.data.claimId == claimId
        && claimId == request.auth.uid + '_' + request.resource.data.offerId
        && exists(/databases/$(database)/documents/fanOffers/$(request.resource.data.offerId))
        && request.resource.data.artistId == get(/databases/$(database)/documents/fanOffers/$(request.resource.data.offerId)).data.artistId
        && (
          get(/databases/$(database)/documents/fanOffers/$(request.resource.data.offerId)).data.audience == 'everyone'
          || (get(/databases/$(database)/documents/fanOffers/$(request.resource.data.offerId)).data.audience == 'followers'
              && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + request.resource.data.artistId)))
          || (get(/databases/$(database)/documents/fanOffers/$(request.resource.data.offerId)).data.audience == 'supporters'
              && hasActiveSupportFor(request.resource.data.artistId))
        );
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.fanId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // stories/{storyId} — ephemeral artist updates, tiered visibility same
    // shape as artistPosts plus a 4th 'dj' tier gated by the artist's own
    // storiesDjEnabled opt-in (independent of djAllowRequests). Written only
    // via createStory/toggleStoryHighlight/adminDeleteStory (Admin SDK) so
    // CTA targets can be server-validated against real tracks — the one
    // client-writable exception is ctaClickCount, a low-stakes counter.
    // ---------------------------------------------------------------------
    match /stories/{storyId} {
      allow read: if resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.artistId == request.auth.uid)
        || (resource.data.visibility == 'followers' && isSignedIn() && (
            exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.artistId))
            || hasActiveSupportFor(resource.data.artistId)))
        || (resource.data.visibility == 'supporters' && hasActiveSupportFor(resource.data.artistId))
        || (resource.data.visibility == 'dj' && hasRole('dj') &&
            get(/databases/$(database)/documents/artistProfiles/$(resource.data.artistId)).data.get('storiesDjEnabled', false) == true)
        || isAdmin();
      allow create: if false;
      allow delete: if isSignedIn() && resource.data.artistId == request.auth.uid;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ctaClickCount'])
        && request.resource.data.ctaClickCount == resource.data.ctaClickCount + 1;
    }

    // storyViews/{storyId_userId} — dedup doc per viewer; direct client write
    // + Firestore trigger aggregates uniqueViewerCount onto the story, same
    // pattern as follows/followerCount. Never deletable (a "seen" state
    // sticks) or updatable.
    match /storyViews/{viewId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && viewId == request.resource.data.storyId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    // storyReactions/{storyId_userId} — one reaction per viewer, deletable
    // (un-react), aggregated onto reactionCount by trigger.
    match /storyReactions/{reactionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && reactionId == request.resource.data.storyId + '_' + request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // storyPollVotes/{storyId_userId} — one vote per viewer, permanent,
    // aggregated onto pollVoteCounts by trigger.
    match /storyPollVotes/{voteId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && voteId == request.resource.data.storyId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    // djDeals/{dealId} — artist-created reusable licence deal templates.
    // Public read (DJs need to see terms on the track page), owner write.
    // Not security-sensitive like licenceAgreements (no money/signature
    // attached until a request references one), so direct client writes are
    // fine here — mirrors artistProfiles/artistPosts rather than the fully
    // callable-only agreement pipeline.
    match /djDeals/{dealId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.artistId == request.auth.uid
        && request.resource.data.dealId == dealId;
      allow update: if isSignedIn() && resource.data.artistId == request.auth.uid
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.dealId == resource.data.dealId;
      allow delete: if isSignedIn() && resource.data.artistId == request.auth.uid;
    }

    // subscriptionPlans/{planId} — admin-configured pricing, public read only.
    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if false; // written only via adminUpsertSubscriptionPlan
    }

    // platformSettings/default (fees) and platformSettings/dataRetention
    // (retention periods) share this rule — both are public-read config,
    // written only via adminUpdatePlatformSettings / adminUpdateDataRetentionSettings.
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // accountDeletions/{uid} — deletion-status tracking written only by the
    // deleteAccount callable. The owner can poll their own deletion's
    // progress; nobody can forge or alter a status client-side.
    match /accountDeletions/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    // rateLimits/{key} — Cloud-Function-only abuse-throttle counters
    // (enforceRateLimit in functions/src/rateLimit.ts). Never client-readable
    // or writable; the count itself isn't meaningful to expose.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // previewSessions/{fanId_artistId} — Cloud-Function-only "did this fan
    // recently preview this artist" signal, read by onFollowCreate/
    // onSupportRelationshipCreate to count real (not assumed) conversions.
    match /previewSessions/{sessionId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Phase 2 — subscriptions, support allocation, revenue records.
    // ---------------------------------------------------------------------
    // Doc ID is `${userId}_${role}` — a user can hold up to 3 concurrent
    // subscriptions, one per role, so ownership is a field check, not an ID check.
    match /subscriptions/{subId} {
      // No doc exists for a user on a role's free/default tier (the common
      // case) — resource == null must short-circuit before dereferencing
      // resource.data, or reading your own absent subscription throws
      // "missing or insufficient permissions" instead of just returning
      // not-found.
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Stripe webhook only
    }

    match /supportAllocations/{fanId} {
      allow read: if isSelf(fanId);
      allow write: if false; // updateSupportAllocations callable only
    }

    match /supportRelationships/{relationshipId} {
      // resource == null short-circuits for the common "not supporting" case
      // — subscribeIsSupporting reads a doc that usually doesn't exist.
      allow read: if isSignedIn() &&
        (resource == null || resource.data.fanId == request.auth.uid || resource.data.artistId == request.auth.uid);
      allow write: if false; // updateSupportAllocations callable only
    }

    match /artistBalances/{artistId} {
      allow read: if isSelf(artistId) || isAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /artistPayoutAccounts/{artistId} {
      allow read: if isSelf(artistId) || isAdmin();
      allow write: if false; // Stripe Connect callables/webhook only
    }

    // notifications/{notificationId} — owner-only, created server-side only.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Phase 3-4 — DJ requests, messaging, agreements. All writes go through
    // callables so status transitions, signatures, and payment gating can't
    // be forged client-side.
    // ---------------------------------------------------------------------
    match /licenceRequests/{docId} {
      allow read: if isSignedIn() && (resource.data.djId == request.auth.uid || resource.data.artistId == request.auth.uid || isAdmin());
      allow write: if false;

      match /events/{eventId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/licenceRequests/$(docId)).data.djId == request.auth.uid ||
          get(/databases/$(database)/documents/licenceRequests/$(docId)).data.artistId == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }
    match /licenceAgreements/{docId} {
      allow read: if isSignedIn() && (resource.data.djId == request.auth.uid || resource.data.artistId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // licenceOffers/{offerId} — versioned offer/counter-offer history.
    // Never overwritten by clients — every new offer or counter is a new
    // doc written by sendOffer/counterOffer/acceptOffer/withdrawOffer.
    match /licenceOffers/{docId} {
      allow read: if isSignedIn() && (resource.data.djId == request.auth.uid || resource.data.artistId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /licenceAgreementAcceptances/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false; // created by submitLicenceRequest, appended to by sendMessage

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow write: if false;
      }
    }
    match /downloadLogs/{docId} {
      allow read: if isSignedIn() && (resource.data.djId == request.auth.uid || resource.data.artistId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Phase 5 — payouts, verification, moderation, admin.
    // ---------------------------------------------------------------------
    match /transactions/{docId} {
      allow read: if isSignedIn() && (resource.data.artistId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payouts/{docId} {
      allow read: if isSignedIn() && (resource.data.artistId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /verificationRequests/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /reports/{docId} {
      // Written only via the submitReport/adminResolveReport callables
      // (Admin SDK, bypasses these rules) — client writes are never valid.
      allow read: if isAdmin();
      allow write: if false;
    }
    match /copyrightClaims/{docId} {
      // Written only via submitCopyrightClaim/reviewCopyrightClaim/
      // submitArtistResponse/submitCounterNotice (Admin SDK). A client
      // `create` here would bypass the callable's declaration/claimant
      // validation and let anyone forge a claim's status or artistId.
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || resource.data.artistId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /supportMessages/{docId} {
      // Written only via submitSupportMessage/resolveSupportMessage (Admin SDK).
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // payoutHolds/{artistId} — admin/system only. An active hold blocks
    // requestPayout; artists can see their own hold status but never set it.
    match /payoutHolds/{artistId} {
      allow read: if isSelf(artistId) || isAdmin();
      allow write: if false;
    }
    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // securityIncidents/{incidentId} — the breach register described in
    // SECURITY_INCIDENT_RESPONSE.md. Admin-only, written exclusively via
    // adminCreateSecurityIncident/adminUpdateSecurityIncident.
    match /securityIncidents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // legalAcceptances/{userId}_{docType}_{version} — append-only. The
    // rights-declaration variant is written by recordRightsDeclaration (a
    // callable, so it can idempotency-guard); ToS/privacy acceptance has no
    // cross-doc validation to enforce, so a direct client write is fine.
    match /legalAcceptances/{docId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
