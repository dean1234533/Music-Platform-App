rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(artistId) {
      return isSignedIn() && request.auth.uid == artistId;
    }

    // 40MB is a generous ceiling for a compressed track (a 320kbps MP3 at
    // 40MB runs ~17 minutes) while keeping storage/egress costs predictable
    // on a free-tier-conscious setup. Raw WAV/FLAC uploads are rejected
    // outright below rather than accepted and left to bloat storage.
    function underAudioUploadLimit() {
      return request.resource.size < 40 * 1024 * 1024;
    }

    function isCompressedAudio() {
      return request.resource.contentType in [
        'audio/mpeg', 'audio/mp4', 'audio/aac', 'audio/x-m4a', 'audio/ogg', 'audio/opus', 'audio/webm'
      ];
    }

    function underImageUploadLimit() {
      return request.resource.size < 8 * 1024 * 1024;
    }

    // Deliberately excludes image/svg+xml: an SVG can carry embedded <script>/
    // event-handler content, and browsers execute it when an SVG URL is
    // opened directly (e.g. an admin opening copyright evidence in a new
    // tab) rather than only when embedded as an <img>. No genuine use case
    // here (artwork/avatars/story media/evidence) needs vector uploads.
    function isImage() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function underVideoUploadLimit() {
      return request.resource.size < 100 * 1024 * 1024;
    }

    // Public artwork — anyone can view, only the owning artist can upload.
    match /artists/{artistId}/artwork/{fileName} {
      allow read: if true;
      allow write: if isOwner(artistId) && underImageUploadLimit() && isImage();
    }

    // Preview clips are private at Storage. getTrackPlaybackUrl validates
    // live Firestore visibility and moderation state, then returns a
    // short-lived signed URL for entitled playback.
    match /artists/{artistId}/previews/{fileName} {
      // Playback is issued through getTrackPlaybackUrl after checking the
      // current Firestore entitlement/takedown state.
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underAudioUploadLimit() && isCompressedAudio();
    }

    // Separate DJ-focused preview derivative. DJ entitlement is checked by
    // getTrackPlaybackUrl; Storage itself remains owner-only.
    match /artists/{artistId}/dj-previews/{fileName} {
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underAudioUploadLimit() && isCompressedAudio();
    }

    // Full-length optimised streaming version — visibility-gated exactly
    // like the track doc itself (public/followers/supporters), not just
    // publicly readable like previews.
    match /artists/{artistId}/streaming/{fileName} {
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underAudioUploadLimit() && isCompressedAudio();
    }

    // Full-quality originals — NEVER publicly readable. Only the owning
    // artist can read/write directly; DJ downloads are served exclusively
    // through a Cloud Function issuing short-lived signed URLs (Phase 4),
    // never through a client-readable Storage rule. Still must be a
    // compressed format — WAV/FLAC uploads are rejected here too, since
    // "original" means the master the artist licenses, not an unbounded
    // raw-file dumping ground.
    match /artists/{artistId}/originals/{fileName} {
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underAudioUploadLimit() && isCompressedAudio();
    }

    // Supporter-only content — owner can always read/write; a supporter's
    // read access is enforced once Phase 2 support entitlements exist in
    // Firestore (checked here via a cross-service firestore.get on the
    // supportRelationships collection).
    match /artists/{artistId}/supporter-content/{fileName} {
      // Relationship existence alone is not proof of an active paid
      // subscription. Entitled delivery must go through a server check.
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underAudioUploadLimit() && isCompressedAudio();
    }

    function isStoryMedia() {
      return isImage() || isVideo() || isCompressedAudio();
    }

    // Story tier is baked directly into the path (unlike tracks, which need
    // a Firestore visibility lookup) — no cross-service read needed for the
    // public/followers/supporters tiers, keeping this far simpler than the
    // streaming/previews checks above.
    match /artists/{artistId}/stories/public/{fileName} {
      allow read: if true;
      allow write: if isOwner(artistId) && underVideoUploadLimit() && isStoryMedia();
    }
    // followers/supporters/dj tiers are owner-only at Storage — cross-service
    // firestore.get()/exists() calls from Storage rules don't work in this
    // project (Firestore and the Storage bucket aren't in the same
    // location; every such call here silently fails closed regardless of
    // the logic). Entitled reads go through getStoryMediaUrl, which checks
    // the same follows/supportRelationships/storiesDjEnabled conditions
    // from a Cloud Function instead and hands back a short-lived signed
    // URL — also fixing the separate issue that a permanent
    // getDownloadURL() token, once stored on the story doc, would keep
    // working after the viewer unfollowed/lost entitlement.
    match /artists/{artistId}/stories/followers/{fileName} {
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underVideoUploadLimit() && isStoryMedia();
    }
    match /artists/{artistId}/stories/supporters/{fileName} {
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underVideoUploadLimit() && isStoryMedia();
    }
    match /artists/{artistId}/stories/dj/{fileName} {
      allow read: if isOwner(artistId);
      allow write: if isOwner(artistId) && underVideoUploadLimit() && isStoryMedia();
    }

    // User avatar / profile image uploads.
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && underImageUploadLimit() && isImage();
    }

    // Copyright claim evidence — claim filing is intentionally open to
    // anyone (per submitCopyrightClaim), so the claimId is generated
    // client-side and evidence uploaded here before the claim doc itself is
    // written; only the claimant (once the claim exists) or an admin can
    // read it back. Images or PDFs, same size ceiling as images.
    // Cross-service firestore.get()/exists() calls don't work in this
    // project (see the previews/streaming comment above) — every branch
    // below that depended on one always fails closed regardless of the
    // actual claim/agreement state. Reads now go through
    // getCopyrightEvidenceUrls (Admin SDK, checks the claim's reporterId
    // or admin role, then lists the prefix directly and signs URLs) rather
    // than a client-readable rule. Writes drop the ownership pre-check —
    // claimId is an unguessable fresh ID, and submitCopyrightClaim itself
    // validates the claim before trusting anything uploaded here.
    match /copyrightEvidence/{claimId}/{fileName} {
      allow read: if false;
      allow write: if isSignedIn() && underImageUploadLimit() &&
        (isImage() || request.resource.contentType == 'application/pdf');
    }

    // licenceSignatures/{agreementId}/{fileName} — drawn e-signature images.
    // ContractPage now renders these via getSignatureImageUrls (Admin SDK,
    // checks the caller is a party to the agreement, returns short-lived
    // signed URLs) rather than a client-readable rule — stays write-only
    // here. agreementId is an unguessable fresh ID; signAgreement validates
    // the signature reference server-side before relying on it.
    match /licenceSignatures/{agreementId}/{fileName} {
      allow read: if false;
      allow write: if isSignedIn() && underImageUploadLimit() && isImage();
    }

    // exports/{uid}/{fileName} — user data exports (exportUserData). Never
    // directly readable or writable by any client, even the owner — the
    // callable hands back a short-lived signed URL instead, since this path
    // can combine several collections' worth of personal data in one file.
    match /exports/{uid}/{fileName} {
      allow read, write: if false;
    }
  }
}
