{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "backthevibes/support-button",
	"title": "BackTheVibes Support Button",
	"category": "widgets",
	"icon": "heart",
	"description": "A button linking straight to supporting your artist on BackTheVibes.",
	"keywords": [ "backthevibes", "support", "donate" ],
	"textdomain": "backthevibes",
	"attributes": {
		"artist": { "type": "string", "default": "" },
		"label": { "type": "string", "default": "" }
	},
	"supports": { "html": false },
	"editorScript": "backthevibes-blocks-editor",
	"render": "file:./render.php"
}
