{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "backthevibes/music-grid",
	"title": "BackTheVibes Music",
	"category": "widgets",
	"icon": "playlist-audio",
	"description": "A grid of your public tracks, playable through the official YouTube player.",
	"keywords": [ "backthevibes", "music", "youtube" ],
	"textdomain": "backthevibes",
	"attributes": {
		"artist": { "type": "string", "default": "" },
		"limit": { "type": "number", "default": 6 }
	},
	"supports": { "html": false, "align": [ "wide" ] },
	"editorScript": "backthevibes-blocks-editor",
	"render": "file:./render.php"
}
