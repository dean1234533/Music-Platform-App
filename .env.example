# Firebase web app config (Project settings → General → Your apps).
# These are public client identifiers, not secrets — safe to ship in the
# browser bundle. Never put Stripe secret keys or service account keys here;
# those live only in Cloud Functions environment secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Project settings → Cloud Messaging → Web Push certificates → generate a key pair.
# Also public — it identifies your project to the push service, it isn't a secret.
VITE_FIREBASE_VAPID_KEY=
